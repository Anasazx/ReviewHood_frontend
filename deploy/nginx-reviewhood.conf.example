# Example for /etc/nginx/sites-available/reviewhood.tech
# Assumes the app is deployed to /var/www/tunirate-ssr (see DEPLOY_SSR.md).
# api.reviewhood.tech keeps its own server block and is not affected.

upstream reviewhood_ssr {
    server 127.0.0.1:4000;
    keepalive 32;
}

server {
    listen 80;
    server_name reviewhood.tech www.reviewhood.tech;
    return 301 https://reviewhood.tech$request_uri;
}

server {
    listen 443 ssl;
    server_name www.reviewhood.tech;

    ssl_certificate     /etc/ssl/cloudflare/reviewhood.tech.pem;
    ssl_certificate_key /etc/ssl/cloudflare/reviewhood.tech.key;

    return 301 https://reviewhood.tech$request_uri;
}

server {
    listen 443 ssl http2;
    server_name reviewhood.tech;

    # Cloudflare Origin Certificate, with SSL/TLS mode set to "Full (strict)"
    ssl_certificate     /etc/ssl/cloudflare/reviewhood.tech.pem;
    ssl_certificate_key /etc/ssl/cloudflare/reviewhood.tech.key;

    root /var/www/tunirate-ssr/dist/tunirate/browser;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/xml application/json application/javascript image/svg+xml;

    # Files with a content hash in their name never change
    location ~* "-[A-Z0-9]{8}\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|webp|ico)$" {
        try_files $uri @ssr;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Everything else: a static file if one exists (logo, robots.txt, ...), otherwise the SSR server.
    # There is deliberately no "$uri/" here, so "/" reaches Node instead of the prerendered index.html.
    location / {
        try_files $uri @ssr;
        add_header Cache-Control "public, max-age=3600";
    }

    location @ssr {
        proxy_pass http://reviewhood_ssr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Angular checks this against security.allowedHosts in angular.json
        proxy_set_header Host $host;

        # Angular logs a warning for every untrusted X-Forwarded-* header, and it doesn't need them
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Proto "";

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
